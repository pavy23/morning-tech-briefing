# ─── 로컬 테스트용 환경변수 ───
# 실제 배포는 GitHub Secrets에 등록 (README 참고)

# Gemini API 키 (필수) — https://aistudio.google.com/apikey 에서 무료 발급
GEMINI_API_KEY=AIzaSy-xxxxx

# Resend API 키 (필수) — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxx

# 수신 이메일 (필수 — 코드에 기본값 없음)
TO_EMAIL=you@example.com

# 발신 이메일 (선택)
# 도메인 인증 전: onboarding@resend.dev 만 사용 가능
# 도메인 인증 후: noreply@yourdomain.com 형태로 변경 가능
FROM_EMAIL=Morning Tech Briefing <onboarding@resend.dev>

# 모델 (선택, 기본값: gemini-2.5-flash)
# 더 빠르고 저렴: gemini-2.5-flash-lite (무료 등급 한도 더 넉넉)
# 최신 고성능: gemini-3.5-flash
MODEL=gemini-2.5-flash

# 그라운딩 누락(환각 배치) 가드 (선택, 기본값: 3)
# 실제 기사 URL로 확정된 링크가 이 개수 미만이면 재수집. 0이면 가드 비활성화.
MIN_GROUNDED_LINKS=3

# ─── TypeSafe(Jev) 섀도 판정 (선택) ───
# 키가 있으면 중복/재탕/관련도/카테고리 판정을 로그·리포트로만 남긴다 (메일 내용은 불변).
# 발급: https://typesafe.ai
TYPESAFE_API_KEY=ts_xxxxx
# 리포트에서 중복/재탕으로 표시할 확률 기준 (기본 0.7)
DUP_THRESHOLD=0.7
REPEAT_THRESHOLD=0.7
# 독자 프로필 (선택) — 관련도 판정 기준. JSON 한 줄 또는 자유 텍스트. 없으면 일반 프로필 사용.
# 개인정보이므로 실제 값은 GitHub Secrets에만 넣고 여기엔 예시만 둔다.
READER_PROFILE={"role":"Engineer in heavy industry","strong_interests":["industrial robots","technology strategy"],"weak_interests":["consumer gadget rumors"]}
# "1"이면 수집·판정만 하고 메일은 보내지 않음 (테스트용)
SKIP_EMAIL=

# 브리핑 주제 설정 파일 경로 (선택, 기본: ./briefing.config.json)
BRIEFING_CONFIG=
